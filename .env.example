# ==============================================================
# NaturalHub 环境变量模板
# 复制此文件为 .env，填入真实值后启动项目
# .env 已加入 .gitignore，绝不会被提交到 Git
# ==============================================================

# ---- 数据库 (MySQL / Druid) --------------------------------
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/ry-vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
DB_USERNAME=root
DB_PASSWORD=YOUR_DB_PASSWORD

# Druid 监控台账号密码
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=YOUR_DRUID_PASSWORD

# ---- Redis ------------------------------------------------
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT --------------------------------------------------
JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_32_CHARS

# ---- 百度AI（生物识别）------------------------------------
BAIDU_API_KEY=YOUR_BAIDU_API_KEY
BAIDU_SECRET_KEY=YOUR_BAIDU_SECRET_KEY

# ---- 腾讯云（混元3D）-------------------------------------
TENCENT_SECRET_ID=YOUR_TENCENT_SECRET_ID
TENCENT_SECRET_KEY=YOUR_TENCENT_SECRET_KEY
TENCENT_REGION=ap-guangzhou

# ---- 七牛云（对象存储）------------------------------------
QINIU_ACCESS_KEY=YOUR_QINIU_ACCESS_KEY
QINIU_SECRET_KEY=YOUR_QINIU_SECRET_KEY
QINIU_BUCKET=naturalhub
QINIU_DOMAIN=http://YOUR_QINIU_DOMAIN
QINIU_ZONE=huanan

# ---- Wiki.js 知识库 ---------------------------------------
WIKI_URL=http://YOUR_WIKI_HOST:3000/graphql
WIKI_KEY=YOUR_WIKI_JWT_KEY

# ---- 千问 (Qwen / DashScope) ------------------------------
QWEN_KEY=sk-YOUR_DASHSCOPE_API_KEY
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
